<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.finos.fluxnova.bpm</groupId>
    <artifactId>fluxnova-parent</artifactId>
    <version>2.0.1</version>
  </parent>
  <groupId>org.finos.fluxnova.bpm.test</groupId>
  <artifactId>bpm-testing-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>BPM Testing Parent</name>
  <description>BPM Testing Parent</description>
  <url>https://github.com/finos/fluxnova-testing-framework</url>

  <scm>
    <connection>scm:git:https://github.com/finos/fluxnova-testing-framework.git</connection>
    <developerConnection>scm:git:https://github.com/finos/fluxnova-testing-framework.git</developerConnection>
    <url>https://github.com/finos/fluxnova-testing-framework</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>bpm-testing</module>
    <module>bpm-testing-archetype</module>
    <module>bpm-testing-regression</module>
    <module>bpm-coverage-collection-plugin</module>
    <module>bpm-testing-bom</module>
    <module>bpm-testing-mockito</module>
    <module>bpm-testing-process-coverage</module>
  </modules>

  <properties>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <version.gmavenplus-plugin>3.0.2</version.gmavenplus-plugin>
    <version.assertj>3.27.6</version.assertj>
    <version.junit-platform-launcher>1.11.3</version.junit-platform-launcher>
    <version.jakarta.inject>2.0.1</version.jakarta.inject>
    <version.kotlin-jvm-logging>7.0.14</version.kotlin-jvm-logging>
    <version.gson>2.13.2</version.gson>
    <version.kotlin-maven-plugin>2.2.21</version.kotlin-maven-plugin>
    <version.maven-compiler-plugin>3.11.0</version.maven-compiler-plugin>
    <compile.debug>false</compile.debug>
    <version.hamcrest>2.2</version.hamcrest>
    <version.wiremock>3.3.1</version.wiremock>
    <skipTests>false</skipTests>
    <version.jakarta.el-api>6.0.1</version.jakarta.el-api>
    <version.spock-core>2.4-M6-groovy-4.0</version.spock-core>
    <version.commons-langs>3.19.0</version.commons-langs>
    <version.logback>1.5.18</version.logback>
    <java.version>21</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <version.h2>2.3.232</version.h2>
    <version.jakarta.validation-api>3.1.1</version.jakarta.validation-api>
    <version.kotlin-stdlib>2.2.21</version.kotlin-stdlib>
    <version.maven-surefire-plugin>3.5.4</version.maven-surefire-plugin>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <version.jakarta.annotation-api>3.0.0</version.jakarta.annotation-api>
    <version.slf4j>2.0.17</version.slf4j>
    <version.jacoco-maven-plugin>0.8.9</version.jacoco-maven-plugin>
    <version.hibernate-validator>9.1.3.Final</version.hibernate-validator>
    <version.mockito-kotlin>6.1.0</version.mockito-kotlin>
    <skipITs>false</skipITs>
    <version.junit-jupiter>5.11.3</version.junit-jupiter>
    <version.fluxnova>2.0.1</version.fluxnova>
    <version.jakarta.el>4.0.2</version.jakarta.el>
    <version.sonar.plugin>5.5.0.6356</version.sonar.plugin>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>1.14</version>
        <configuration>
          <acceptPomPackaging>true</acceptPomPackaging>
          <excludedScopes>test</excludedScopes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.4</version>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${version.sonar.plugin}</version>
      </plugin>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <configuration>
          <deploymentName>fluxnova-bpm-testing-framework-${project.version}</deploymentName>
          <publishingServerId>${publish.server.id}</publishingServerId>
          <!-- TODO: its set to false to manually validate the artifacts before publishing, set it to true once successfully tested with all dependent projects-->
          <autoPublish>false</autoPublish>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.finos.fluxnova.bpm</groupId>
        <artifactId>fluxnova-bom</artifactId>
        <version>${version.fluxnova}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>central</id>
      <name>Maven Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>ossrh-snapshots</id>
      <name>Sonatype OSSRH Snapshots</name>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <distributionManagement>
    <snapshotRepository>
      <id>ossrh</id>
      <name>Central Portal Snapshots</name>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

</project>
